[
  {
    "update-requestHandler": {
      "name": "/select",
      "class": "solr.SearchHandler",
      "defaults": {
        "echoParams": "explicit",
        "defType": "edismax",
        "qs": "5",
        "mm": "100%",
        "q.op": "AND",
        "df": "all",
        "rows": 10,
        "fl": "id",
        "facet": "true",
        "facet.mincount": "1",
        "facet.field": [
          "status",
          "partOf",
          "importID",
          "year",
          "connection_nid_text",
          "facet_person",
          "subject",
          "genre",
          "origin_exact",
          "facet_host_title",
          "oa",
          "peerreviewed"
        ],
        "wt": "xml"
      }
    }
  },
  {
    "update-requestHandler": {
      "name": "/statistics",
      "class": "solr.SearchHandler",
      "defaults": {
        "echoParams": "explicit",
        "defType": "edismax",
        "q.alt": "*:*",
        "qs": "5",
        "mm": "100%",
        "df": "all",
        "wt": "xml",
        "f.year.facet.limit": -1,
        "sort":"year desc"
      },
      "appends": {
        "facet.field": [
          "year",
          "subject",
          "origin_toplevel",
          "genre",
          "koeln_accessrights",
          "facet_person",
          "oa_exact",
          "connection_nid_text",
          "nid_connection"
        ],
        "fq": "+objectType:mods"
      },
      "invariants": {
        "fl": "",
        "start": "0",
        "rows": "0",
        "facet": "true",
        "facet.mincount": "1"
      }
    }
  }
]
